{
  "name": "aether-desktop",
  "private": true,
  "version": "2.3.1",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "check:version": "node ../../strumenti/versione.js",
    "check:lingue": "node ../../strumenti/lingue.js",
    "check:classi": "node ../../strumenti/classi.js",
    "version:set": "node ../../strumenti/versione.js",
    "licenze": "node ../../strumenti/licenze.js",
    "verify": "npm run check:version && npm run check:lingue && npm run check:classi && npm run build:web && cargo fmt --all --check --manifest-path ../../Cargo.toml && cargo clippy --workspace --all-targets --manifest-path ../../Cargo.toml && cargo test --workspace --manifest-path ../../Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5",
    "typescript": "^5.9.0",
    "vite": "^7"
  }
}
