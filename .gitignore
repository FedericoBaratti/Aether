# ── Dipendenze e output di build ─────────────────────────────────────────────
node_modules/
# Il workspace Rust sta in radice: un solo `target/` per tutto il repo.
/target/
# Gli schemi dei permessi: li rigenera `tauri-build` a ogni compilazione dalle
# capacità dichiarate. Versionarli significherebbe avere due sorgenti di verità
# per la stessa cosa, e la seconda si accorge di essere vecchia solo quando
# qualcuno legge un errore che non capisce.
apps/desktop/src-tauri/gen/
out/
dist/
dist-mobile/
dist-node/
release/
*.tsbuildinfo
*.log

# ── Binari esterni e strumenti vendorizzati ──────────────────────────────────
# resources/bin: yt-dlp/spotdl/ffmpeg/fpcalc, scaricati durante il setup.
# Il `**/` non è ornamento: una regola con uno slash in mezzo git la ancora alla
# cartella del .gitignore, quindi `resources/bin/` da solo copriva soltanto una
# cartella in radice che non esiste — e lasciava scoperta quella vera, che sta in
# `apps/desktop/src-tauri/`. Se ne accorge chi guarda un `git status` con dentro
# diciotto megabyte di yt-dlp.exe, cioè nessuno finché non è troppo tardi.
**/resources/bin/
# platform-tools: adb e compagnia, dall'Android SDK.
platform-tools/

# ── Archivi ──────────────────────────────────────────────────────────────────
# `legacy/` è già fuori dal repo; `legacy.rar` è lo stesso albero compresso e
# pesa 2,2 GB. Un archivio in un commit non si toglie più: la storia se lo porta
# dietro anche dopo un `git rm`.
# Le skin non sono in questo elenco pur essendo zip: hanno estensione `.aeskin`
# e vivono nel repo di proposito.
*.rar
*.7z
*.zip

# ── Segreti ──────────────────────────────────────────────────────────────────
.env
.secrets/
# Credenziali OAuth e token. Elencati per nome e non solo per cartella: la
# regola serve proprio nel momento in cui qualcuno li salva nel posto sbagliato.
*.secrets.json
client_secret*.json
google-oauth*.json
token*.json
build/*.pfx
build/*.cer
# Perdere il keystore significa non poter più aggiornare l'app con la stessa
# firma: va conservato fuori dal repo, non ignorato e dimenticato.
*.jks
*.keystore
android/keystore.properties

# ── Android / Capacitor: si tengono i sorgenti, si ignora il generato ────────
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
# Bundle prodotto da build:node, in entrambe le posizioni del progetto nodejs-mobile.
android/app/src/main/assets/nodejs-project/main.js
nodejs-assets/nodejs-project/main.js
nodejs-assets/nodejs-project/node_modules/
# Librerie native prebuilt (libnode.so, binari ARM), aggiunte durante il setup.
android/app/src/main/jniLibs/**/*.so

# ── Analisi del codice ───────────────────────────────────────────────────────
# graphify-out: grafo rigenerabile, graph.json da solo pesa 27 MB.
graphify-out/

# ── Sistema ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# -- Credenziali OAuth della macchina di build ---------------------------------
# Le si passa a `build.rs` da qui o dalle variabili d'ambiente. Se questo file
# finisse in un commit, il rimedio NON e' toglierlo: e' eliminare il client in
# Google Cloud Console e farne uno nuovo. Togliere le righe non le de-pubblica
# dalla storia di git.
apps/desktop/src-tauri/oauth.local.toml
