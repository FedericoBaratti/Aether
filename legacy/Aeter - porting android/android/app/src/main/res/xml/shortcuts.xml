<?xml version="1.0" encoding="utf-8"?>
<!-- App Actions: maps the PLAY_MUSIC built-in intent ("Hey Google / Gemini,
     riproduci X su Aether" phone-side) onto VoicePlayActivity, which resolves the
     entity against the Auto catalog (AutoVoice) and starts native playback.

     Note: Google only activates App Actions for Play-Store-distributed apps; on a
     sideload build this file is inert (testable with the App Actions Test Tool).
     In-car voice doesn't need it — Gemini reaches the MediaSession directly. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <capability android:name="actions.intent.PLAY_MUSIC">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.aether.player"
            android:targetClass="com.aether.player.VoicePlayActivity">
            <parameter android:name="musicTrack.name" android:key="track" />
            <parameter android:name="musicTrack.byArtist.name" android:key="artist" />
            <parameter android:name="musicAlbum.name" android:key="album" />
            <parameter android:name="musicPlaylist.name" android:key="playlist" />
            <parameter android:name="musicGroup.name" android:key="artist" />
        </intent>
    </capability>
</shortcuts>
