  "triggers": {
    "tracks_ad": "CREATE TRIGGER tracks_ad AFTER DELETE ON tracks BEGIN INSERT INTO tracks_fts(tracks_fts, rowid, title, artist, album, album_artist) VALUES ('delete', old.id, old.title, old.artist, old.album, old.album_artist); END",
    "tracks_ai": "CREATE TRIGGER tracks_ai AFTER INSERT ON tracks BEGIN INSERT INTO tracks_fts(rowid, title, artist, album, album_artist) VALUES (new.id, new.title, new.artist, new.album, new.album_artist); END",
    "tracks_au": "CREATE TRIGGER tracks_au AFTER UPDATE ON tracks BEGIN INSERT INTO tracks_fts(tracks_fts, rowid, title, artist, album, album_artist) VALUES ('delete', old.id, old.title, old.artist, old.album, old.album_artist); INSERT INTO tracks_fts(rowid, title, artist, album, album_artist) VALUES (new.id, new.title, new.artist, new.album, new.album_artist); END"
