{
  "name": "aether",
  "version": "1.0.0",
  "description": "Aether — local-first music player with downloads and metadata enrichment",
  "main": "out/main/main.js",
  "type": "module",
  "author": "Federico Baratti",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource-variable/doto": "^5.2.10",
    "@fontsource-variable/orbitron": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/rajdhani": "^5.2.7",
    "@fontsource/space-mono": "^5.2.9",
    "better-sqlite3": "^11.7.0",
    "bonjour-service": "^1.4.3",
    "chokidar": "^4.0.3",
    "music-metadata": "^10.6.4",
    "node-taglib-sharp": "^5.2.3",
    "p-queue": "^8.0.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-virtual": "^3.11.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/howler": "^2.2.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "howler": "^2.2.4",
    "i18next": "^24.2.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.468.0",
    "node-vibrant": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0",
    "react-router-dom": "^7.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.8",
    "zustand": "^5.0.2"
  }
}
